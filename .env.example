# Managed PostgreSQL only. Configure credentials before starting the API.
POSTGRES_DB=nearkart
POSTGRES_USER=
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=
VITE_API_BASE_URL=http://localhost:8080/api/v1
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
AUTH_SECURE_COOKIE=false
AUTH_COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
INVENTORY_FRESH_FOR=PT30M
INVENTORY_RECENT_FOR=PT2H
INVENTORY_STALE_AFTER=P1D
